# Copy to .env beside docker-compose.yml and fill it in. Git ignores .env.

# The API's address. Its DNS A record must point at the server before the first `docker compose up`,
# so Caddy can get its certificate.
API_DOMAIN=api.example.com

# The site that may call the API from the browser.
SITE_ORIGIN=https://hosam9988.github.io

# Letters and digits only, since it goes into a connection string. For example: openssl rand -hex 24
# The database keeps the password it was first created with: to change it later, see README.md, "Deploying".
POSTGRES_PASSWORD=
