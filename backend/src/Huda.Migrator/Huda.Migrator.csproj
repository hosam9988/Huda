<Project Sdk="Microsoft.NET.Sdk">

  <!-- The outer layer, as a console: it migrates the database and runs the import, wired as the API is. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- For `dotnet ef migrations add`, which uses this project as its startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Huda.Application\Huda.Application.csproj" />
    <ProjectReference Include="..\Huda.Infrastructure\Huda.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
